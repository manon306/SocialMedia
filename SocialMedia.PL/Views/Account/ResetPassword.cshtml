@model SocialMedia.BLL.ModelVM.Account.ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_NewLayout";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg border-0 rounded-3" style="width: 400px;">
        <div class="card-header text-center bg-primary text-white rounded-top">
            <h4 class="mb-0">@SharedLocalizer["Reset Password"]</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />

                <div class="form-group mb-3">
                    <label asp-for="Password" class="form-label fw-bold"></label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Enter new password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm new password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-key-fill me-1"></i> @SharedLocalizer["Reset Password"]
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
