@model SocialMedia.BLL.ModelVM.Account.ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_NewLayout";
}

<div class="d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 420px; width: 100%;">
        <div class="card-body">
            <h3 class="text-center mb-4">Forgot Password</h3>

            <form asp-action="ForgotPassword" method="post">
                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 rounded-3">
                     @SharedLocalizer["Send Reset Link"]
                </button>
            </form>
        </div>
    </div>
</div>
