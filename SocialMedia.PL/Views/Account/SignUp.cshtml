@model SignUpVM
@{
    ViewData["Title"] = "SignUp";
    Layout = "_NewLayout";
    <!-- أو خليه null لو عايزة صفحة مستقلة -->
}

<div class="d-flex align-items-center justify-content-center vh-100">

    <div class="card shadow-lg border-0 rounded-4" style="width: 420px;">
        <!-- Header -->
        <div class="card-header text-center text-white fw-bold rounded-top-4"
             style="background: linear-gradient(135deg, #4facfe, #00f2fe); font-size: 1.3rem;">
            <i class="bi bi-person-plus"></i> Sign Up
        </div>

        <!-- Body -->
        <div class="card-body p-4">
            <form enctype="multipart/form-data" asp-action="SignUp" asp-controller="Account">
                <!-- Username -->
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label fw-bold">Username</label>
                    <input asp-for="UserName" class="form-control rounded-3" placeholder="Enter your username" />
                    <span class="text-danger small" asp-validation-for="UserName"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold">Email</label>
                    <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="example@email.com" />
                    <span class="text-danger small" asp-validation-for="Email"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-bold">Password</label>
                    <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Enter a strong password" />
                    <span class="text-danger small" asp-validation-for="Password"></span>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn btn-primary w-100 rounded-3">
                    <i class="bi bi-check-circle"></i> Create Account
                </button>
            </form>

            <!-- Login Link -->
            <div class="text-center mt-3">
                <small>
                    Already have an account?
                    <a asp-action="Login" asp-controller="Account" class="text-decoration-none fw-bold">Login</a>
                </small>
            </div>
        </div>
    </div>
</div>
