@using Microsoft.AspNetCore.Identity
@inject UserManager<SocialMedia.DAL.Entity.User> UserManager
@model List<SocialMedia.DAL.Entity.User>

@{
    ViewData["Title"] = SharedLocalizer["Manage User Roles"];
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h4 class="mb-0"><i class="bi bi-people-fill me-2"></i> @SharedLocalizer["Manage User Roles"]</h4>
        </div>
        <div class="card-body bg-dark text-white rounded-bottom-4">
            <table class="table table-hover align-middle text-white">
                <thead class="table-dark">
                    <tr>
                        <th>@SharedLocalizer["Email"]</th>
                        <th>@SharedLocalizer["Current Roles"]</th>
                        <th>@SharedLocalizer["Assign New Role"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@user.Email</td>
                            <td>
                                @foreach (var role in await UserManager.GetRolesAsync(user))
                                {
                                    <span class="badge bg-success me-1 p-2">
                                        <i class="bi bi-shield-lock-fill me-1"></i>@role
                                    </span>
                                }
                            </td>
                            <td>
                                <form asp-action="AssignRole" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="userId" value="@user.Id" />

                                    <select name="roleName" class="form-select bg-secondary text-white">
                                        <option value="Admin">Admin</option>
                                        <option value="User">User</option>
                                    </select>

                                    <button type="submit" class="btn btn-outline-light btn-sm">
                                        <i class="bi bi-plus-circle me-1"></i>@SharedLocalizer["Assign"]
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
