@using Microsoft.AspNetCore.Identity
@inject UserManager<SocialMedia.DAL.Entity.User> UserManager
@model List<SocialMedia.DAL.Entity.User>

<h2>Manage User Roles</h2>

<table class="table table-bordered">
    <thead>
        <tr class="text-white">
            <th>Email</th>
            <th>Current Roles</th>
            <th>Assign New Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr class="text-white">
                <td>@user.Email</td>
                <td>
                        @foreach (var role in await UserManager.GetRolesAsync(user))
                        {
                            <span class="badge bg-primary me-1 p-3">@role</span>
                        }
                </td>
                <td>
                    <form asp-action="AssignRole" method="post" >
                        <input type="hidden" name="userId" value="@user.Id" />

                        <select name="roleName" class="form-control bg-black text-white ">
                            <option value="Admin">Admin</option>
                            <option value="User">User</option>
                        </select>

                        <button type="submit" class="btn btn-primary btn-sm">Assign</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
