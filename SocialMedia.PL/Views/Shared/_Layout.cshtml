@inject IUserProfileService profileService
@inject UserManager<User> userManager

@{
    var user = await userManager.GetUserAsync(Context.User);
    string profileImagePath = "default-profile.jpg";

    if (user != null)
    {
        var profile = await profileService.GetProfile(user.Id.ToString());
        profileImagePath = profile?.ProfileImagePath ?? "default-profile.jpg";
    }

    ViewData["LayoutProfileImage"] = profileImagePath;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SocialMedia.PL</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SocialMedia.PL.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QIlR0Xn1L6cfu3zOa7uHh6T+2dg=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

</head>
<a href="@Url.Action("AITOOL", "Ai")"
   class="ai-btn"
   title="المساعد الذكي">
    <i class="fas fa-robot"></i>
</a>
<style>
    
</style>
<body class="bg-light">

    <!-- ✅ Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg shadow-sm fixed-top text-white">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary" href="#">ConnectPro</a>

                <!-- ✅ زرار الهامبرجر للموبايل -->
                <button class="navbar-toggler navbar-dark bg-dark" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menu -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item mx-2">
                            <a asp-controller="Post" asp-action="Index" class="nav-link text-white">
                                <i class="bi bi-house-door fs-5"></i><br /><small>Home</small>
                            </a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link text-white" asp-area="" asp-controller="Jobs" asp-action="Index">
                                <i class="bi bi-briefcase fs-5"></i><br /><small>Jobs</small>
                            </a>
                        </li>
                        <li class="nav-item mx-2">
                            <a asp-controller="Home" asp-action="Index"  class="nav-link text-white">
                                <i class="bi bi-chat-dots fs-5"></i><br /><small>Messaging</small>
                            </a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link text-white" href="#">
                                <i class="bi bi-bell fs-5"></i><br /><small>Notifications</small>
                            </a>
                        </li>
                        <li class="nav-item mx-2">
                            <a asp-area="" asp-controller="UserProfile" asp-action="MyProfile" class="nav-link text-white">
                                <img src="@Url.Content("~/Files/" + ViewData["LayoutProfileImage"])"
                                     class="rounded-circle me-2" width="40" height="40" alt="Profile">
                                <br /><small>Me</small>
                            </a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link text-white" asp-action="LogOff" asp-controller="Account">
                                <i class="bi bi-box-arrow-right fs-5"></i><br /><small>LogOut</small>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

    </header>

    <!-- ✅ Page Layout -->
    <div class="container-fluid text-white" style="margin-top: 70px; background-color: var(--primary-color);">
        <div class="row">

            <!-- Left Aside -->
            <aside class="col-md-3 col-lg-2 border-end p-3" style="background-color: var(--secondary-color);">
                <div class="text-center mb-3 p-3 rounded-4">
                    <div class="rounded-circle overflow-hidden mx-auto mb-3 border border-3" style="width: 80px; height: 80px; border-color: var(--accent-color) !important;">
                        <img src="@Url.Content("~/Files/" + (ViewData["LayoutProfileImage"] ?? "default-profile.jpg"))" class="w-100 h-100" alt="Profile">
                    </div>
                    <h6 class="fw-bold text-white">
                        @User.Identity?.Name
                    </h6>
                    <p class="small" style="color: var(--muted-text);">مطور تطبيقات ويب</p>
                </div>
                <div class="modern-menu">
                    <!-- زر إنشاء البروفايل -->
                    <a href="/UserProfile/Create" class="modern-item create-profile-btn" style="background-color: var(--header-color);">
                        <div class="modern-icon" style="background: linear-gradient(135deg, var(--accent-color), #764ba2);">
                            <i class="bi bi-plus-lg"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title text-white">Create Profile</div>
                            <div class="modern-subtitle" style="color: var(--muted-text);">Set up your profile</div>
                        </div>
                    </a>

                    <a class="modern-item" asp-action="MyProfile" asp-controller="UserProfile" style="background-color: var(--header-color);">
                        <div class="modern-icon" style="background: linear-gradient(135deg, var(--accent-color), #764ba2);">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title text-white">My Profile</div>
                            <div class="modern-subtitle" style="color: var(--muted-text);">View your profile</div>
                        </div>
                    </a>

                    <a class="modern-item" asp-action="ViewProfile" asp-controller="UserProfile" style="background-color: var(--header-color);">
                        <div class="modern-icon" style="background: linear-gradient(135deg, var(--accent-color), #764ba2);">
                            <i class="bi bi-eye"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title text-white">View Profile</div>
                            <div class="modern-subtitle" style="color: var(--muted-text);">See others' profiles</div>
                        </div>
                    </a>

                    <a class="modern-item" asp-action="Friends" asp-controller="Connection" style="background-color: var(--header-color);">
                        <div class="modern-icon" style="background: linear-gradient(135deg, var(--accent-color), #764ba2);">
                            <i class="bi bi-people"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title text-white">Connections</div>
                            <div class="modern-subtitle" style="color: var(--muted-text);">12 friends</div>
                        </div>
                    </a>

                    <a class="modern-item" asp-action="Requests" asp-controller="Connection" style="background-color: var(--header-color);">
                        <div class="modern-icon" style="background: linear-gradient(135deg, var(--accent-color), #764ba2);">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title text-white">Requests</div>
                            <div class="modern-subtitle" style="color: var(--muted-text);">5 pending</div>
                        </div>
                        <div class="modern-badge">5</div>
                    </a>
                    <a class="modern-item" asp-action="AllUsers" asp-controller="Connection" style="background-color: var(--header-color);">
                        <div class="modern-icon" style="background: linear-gradient(135deg, var(--accent-color), #764ba2);">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title text-white">AllUsers</div>
                            <div class="modern-subtitle" style="color: var(--muted-text);">5 pending</div>
                        </div>
                        <div class="modern-badge">5</div>
                    </a>
                </div>
            </aside>


            <!-- Main Content -->
            <main class="col-md-6 col-lg-8 p-4">
                @RenderBody()
            </main>
            <!-- 📌 Right Aside -->
            <aside class="col-md-3 col-lg-2 border-start p-3 mt-3 "
                   style="background: linear-gradient(180deg, var(--secondary-color), #1e1e2f); min-height: 100vh;">

                <h5 class="mb-4 text-center fw-bold" style="color: var(--accent-color);">
                    Quick Links
                </h5>

                <ul class="list-group list-group-flush flex-column gap-2" style="margin-top: 20px;">
                    <li class="list-group-item border-0 rounded-3"
                        style="background-color: rgba(255,255,255,0.05);">
                        <a asp-controller="Post" asp-action="GetAllSavedPosts"
                           class="text-decoration-none d-block py-2 px-2 fw-semibold"
                           style="color: #f1f1f1;">
                            💾 Saved Posts
                        </a>
                    </li>

                    <li class="list-group-item border-0 rounded-3"
                        style="background-color: rgba(255,255,255,0.05);">
                        <a asp-controller="Post" asp-action="GetAllArchivedPosts"
                           class="text-decoration-none d-block py-2 px-2 fw-semibold"
                           style="color: #f1f1f1;">
                            🗂️ Archived Posts
                        </a>
                    </li>
                    <li class="list-group-item border-0 rounded-3"
                        style="background-color: rgba(255,255,255,0.05);">
                        <a asp-controller="jobs" asp-action="Saved"
                           class="text-decoration-none d-block py-2 px-2 fw-semibold"
                           style="color: #f1f1f1;">
                            🗂️ Saved jobs
                        </a>
                    </li>

                    <li class="list-group-item border-0 rounded-3"
                        style="background-color: rgba(255,255,255,0.05);">
                        <a asp-controller="Ai" asp-action="AITOOL"
                           class="text-decoration-none d-block py-2 px-2 fw-semibold"
                           style="color: #f1f1f1;">
                            🤖 AI Assistant
                        </a>
                    </li>
                </ul>
            </aside>
        </div>
    </div>

    <!-- ✅ Footer -->
    <footer class="border-top py-4 ">
        <div class="container text-center">
            <p class="small text-muted mb-0">© 2023 ConnectPro. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
