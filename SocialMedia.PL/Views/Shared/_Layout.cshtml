                                <a class="nav-link text-white" asp-controller="Admin" asp-action="ManageRoles">
                                    <i class="bi bi-speedometer2 fs-5"></i><br /><small>@SharedLocalizer["Dashboard"]</small>
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a asp-controller="Payment" asp-action="Pay" class="nav-link text-white">
                                <i class="bi bi-star-fill fs-5" style="color: gold;"></i><br /><small>@SharedLocalizer["Upgrade To Premium"]</small>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="UserProfile" asp-action="MyProfile" class="nav-link text-white">
                                <img src="@Url.Content("~/Files/" + ViewData["LayoutProfileImage"])"
                                     class="rounded-circle me-2" width="40" height="40" alt="Profile">
                                <br /><small>@SharedLocalizer["Me"]</small>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-action="LogOff" asp-controller="Account">
                                <i class="bi bi-box-arrow-right fs-5"></i><br /><small>@SharedLocalizer["LogOut"]</small>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ✅ Page Layout -->
    <div class="container-fluid text-white" style="margin-top: 76px;">
        <div class="row h-100">

            <!-- Left Aside -->
            <aside class="col-md-3 col-lg-2 p-3">
                <div class="profile-section">
                    <div class="profile-image-container">
                        <img src="@Url.Content("~/Files/" + (ViewData["LayoutProfileImage"] ?? "default-profile.jpg"))" alt="Profile">
                    </div>
                    <h6 class="fw-bold text-white text-center mb-2">
                        @User.Identity?.Name.Split('@')[0]
                    </h6>
                    <p class="text-center mb-0" style="color: var(--muted-text); font-size: 0.9rem;">
                        <i class="bi bi-patch-check-fill me-1" style="color: var(--accent-color);"></i>
                        Active Member
                    </p>
                </div>

                <div class="modern-menu">
                    <!-- زر إنشاء البروفايل -->
                    <a href="/UserProfile/Create" class="modern-item">
                        <div class="modern-icon">
                            <i class="bi bi-plus-lg"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title">@SharedLocalizer["Create Profile"]</div>
                            <div class="modern-subtitle">@SharedLocalizer["Set up your profile"]</div>
                        </div>
                    </a>

                    <a class="modern-item" asp-action="MyProfile" asp-controller="UserProfile">
                        <div class="modern-icon">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title">@SharedLocalizer["My Profile"]</div>
                            <div class="modern-subtitle">@SharedLocalizer["View your profile"]</div>
                        </div>
                    </a>

                    <a class="modern-item" asp-action="ViewProfile" asp-controller="UserProfile">
                        <div class="modern-icon">
                            <i class="bi bi-eye"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title">@SharedLocalizer["View Profile"]</div>
                            <div class="modern-subtitle">@SharedLocalizer["See others' profiles"]</div>
                        </div>
                    </a>

                    <a class="modern-item" asp-action="Friends" asp-controller="Connection">
                        <div class="modern-icon">
                            <i class="bi bi-people"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title">@SharedLocalizer["Connections"]</div>
                            <div class="modern-subtitle">Manage your network</div>
                        </div>
                    </a>

                    <a class="modern-item" asp-action="Requests" asp-controller="Connection">
                        <div class="modern-icon">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title">@SharedLocalizer["Requests"]</div>
                            <div class="modern-subtitle">Connection requests</div>
                        </div>
                        <div class="modern-badge">5</div>
                    </a>

                    <a class="modern-item" asp-action="AllUsers" asp-controller="Connection">
                        <div class="modern-icon">
                            <i class="bi bi-search"></i>
                        </div>
                        <div class="modern-content">
                            <div class="modern-title">@SharedLocalizer["AllUsers"]</div>
                            <div class="modern-subtitle">Discover new people</div>
                        </div>
                    </a>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="col-md-6 col-lg-8 p-4">
                @RenderBody()
            </main>

            <!-- Right Aside -->
            <aside class="col-md-3 col-lg-2 p-3 quick-links">
                <h5 class="mb-4 text-center fw-bold">
                    <i class="bi bi-lightning-charge-fill me-2"></i>Quick Links
                </h5>

                <ul class="list-group list-group-flush flex-column gap-2">
                    <li class="list-group-item">
                        <a asp-controller="Post" asp-action="GetAllSavedPosts"
                           class="text-decoration-none d-flex align-items-center py-2">
                            <i class="bi bi-save me-3"></i>
                            <span>@SharedLocalizer["Saved Posts"]</span>
                        </a>
                    </li>

                    <li class="list-group-item">
                        <a asp-controller="Post" asp-action="GetAllArchivedPosts"
                           class="text-decoration-none d-flex align-items-center py-2">
                            <i class="bi bi-archive me-3"></i>
                            <span>@SharedLocalizer["Archived Posts"]</span>
                        </a>
                    </li>

                    <li class="list-group-item">
                        <a asp-controller="jobs" asp-action="Saved"
                           class="text-decoration-none d-flex align-items-center py-2">
                            <i class="bi bi-briefcase me-3"></i>
                            <span>@SharedLocalizer["Saved jobs"]</span>
                        </a>
                    </li>
                    <li class="list-group-item">
                        <form asp-controller="User" asp-action="Suggest" method="post">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-primary btn-sm">View Profile</button>
                        </form>

                    </li>

                    <li class="list-group-item">
                        <a asp-controller="Ai" asp-action="AITOOL"
                           class="text-decoration-none d-flex align-items-center py-2">
                            <i class="bi bi-robot me-3"></i>
                            <span>AI Assistant</span>
                        </a>
                    </li>

                    <li class="list-group-item border-0 bg-transparent mt-3">
                        <div class="dropdown">
                            <button class="btn btn-outline-light w-100 dropdown-toggle d-flex align-items-center justify-content-center"
                                    type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-translate me-2"></i>
                                Language
                            </button>
                            <ul class="dropdown-menu shadow border-0 rounded-3" aria-labelledby="languageDropdown">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center"
                                       href="@Url.Action("SetLanguage", "Home", new { culture = "en-US", returnUrl = Context.Request.Path + Context.Request.QueryString })">
                                        <i class="bi bi-flag-fill me-2 text-primary"></i>
                                        <span>English</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center"
                                       href="@Url.Action("SetLanguage", "Home", new { culture = "ar-EG", returnUrl = Context.Request.Path + Context.Request.QueryString })">
                                        <i class="bi bi-flag-fill me-2 text-success"></i>
                                        <span>العربية</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </aside>
        </div>
    </div>

    <!-- ✅ Footer -->
    <footer class="border-top py-4 mt-auto">
        <div class="container text-center">
            <p class="small text-muted mb-0">
                <i class="bi bi-c-circle me-1"></i> 2023 ConnectPro. @SharedLocalizer["All rights reserved."]
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Add smooth scrolling and interactive effects
        document.addEventListener('DOMContentLoaded', function() {
            // Add hover effects to navigation items
            const navItems = document.querySelectorAll('.nav-link');
            navItems.forEach(item => {
                item.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                });
                item.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });

            // Add loading animation for modern items
            const modernItems = document.querySelectorAll('.modern-item');
            modernItems.forEach((item, index) => {
                item.style.animationDelay = `${index * 0.1}s`;
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>