<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ConnectPro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SocialMedia.PL.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QIlR0Xn1L6cfu3zOa7uHh6T+2dg=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #1a1a2e;
            --secondary-color: #16213e;
            --accent-color: #0fce5b;
            --header-color: #0d1930;
            --text-color: #ffffff;
            --muted-text: #b0b0b0;
            --card-bg: rgba(255, 255, 255, 0.05);
            --hover-effect: rgba(15, 206, 91, 0.1);
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
        }

        body {
            background: linear-gradient(135deg, var(--primary-color) 0%, #0f3460 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Navbar Enhancements */
        .navbar {
            background: linear-gradient(90deg, var(--header-color) 0%, var(--secondary-color) 100%) !important;
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow);
            padding: 0.8rem 0;
        }

        .navbar-brand {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(45deg, var(--accent-color), #2ecc71);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            transition: all 0.3s ease;
            border-radius: 8px;
            margin: 0 5px;
            padding: 8px 12px !important;
        }
         .nav-link:hover {
                background: var(--hover-effect);
                transform: translateY(-2px);
         }

            .nav-link small {
                font-size: 0.75rem;
                transition: color 0.3s ease;
            }

            .nav-link:hover small {
                color: var(--accent-color) !important;
            }

        /* Main Container */
        .container-fluid {
            min-height: calc(100vh - 76px);
        }

        /* Sidebar Enhancements */
        aside {
            background: linear-gradient(180deg, var(--secondary-color) 0%, var(--header-color) 100%) !important;
            border: none !important;
            box-shadow: 5px 0 15px rgba(0, 0, 0, 0.2);
            margin-top: 20px;
            position: sticky;
            top: 0;
            height: 115vh;
            margin-bottom: 100px;
        }

        /* Profile Section */
        .profile-section {
            background: var(--card-bg);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: transform 0.3s ease;
            
        }

            .profile-section:hover {
                transform: translateY(-5px);
            }

        .profile-image-container {
            width: 100px;
            height: 100px;
            margin: 0 auto 15px;
            border: 3px solid var(--accent-color);
            border-radius: 50%;
            padding: 3px;
            background: var(--secondary-color);
            box-shadow: 0 0 20px rgba(15, 206, 91, 0.3);
        }

            .profile-image-container img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 50%;
            }

        /* Modern Menu Items */
        .modern-menu {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom:20px;
        }
        .modern-item {
            display: flex;
            align-items: center;
            padding: 15px;
            background: var(--card-bg) !important;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 1px solid transparent;
            position: relative;
        }
            .modern-item::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(15, 206, 91, 0.1), transparent);
                transition: left 0.5s;
            }

            .modern-item:hover::before {
                left: 100%;
            }

            .modern-item:hover {
                transform: translateX(5px);
                border-color: var(--accent-color);
                box-shadow: 0 5px 15px rgba(15, 206, 91, 0.2);
            }

        .modern-icon {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-size: 1.2rem;
            color: white;
            flex-shrink: 0;
        }

        .modern-content {
            flex-grow: 1;
        }

        .modern-title {
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 3px;
        }

        .modern-subtitle {
            font-size: 0.8rem;
            opacity: 0.8;
        }

        .modern-badge {
            background: linear-gradient(45deg, #ff6b6b, #ee5a52);
            color: white;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        /* Main Content Area */
        main {
            background: transparent;
            min-height: calc(100vh - 140px);
        }

        /* Quick Links */
        .quick-links h5 {
            position: relative;
            padding-bottom: 10px;
            margin-top:20px;
        }

            .quick-links h5::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 25%;
                width: 50%;
                height: 2px;
                background: var(--accent-color);
                border-radius: 2px;
            }

        .list-group-item {
            background: var(--card-bg) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            margin-bottom: 8px;
            border-radius: 10px !important;
            transition: all 0.3s ease;
            color: var(--text-color);
        }

            .list-group-item:hover {
                transform: translateX(5px);
                border-color: var(--accent-color) !important;
                box-shadow: 0 5px 15px rgba(15, 206, 91, 0.1);
            }

            .list-group-item a {
                color: inherit;
                text-decoration: none;
                transition: color 0.3s ease;
            }

            .list-group-item:hover a {
                color: var(--accent-color) !important;
            }

        /* AI Button */
        .ai-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--accent-color), #2ecc71);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            box-shadow: 0 5px 20px rgba(15, 206, 91, 0.4);
            z-index: 1000;
            transition: all 0.3s ease;
            text-decoration: none;
            animation: pulse 2s infinite;
        }
        .ai-btn:hover {
                transform: scale(1.1);
                color: white;
         }
        /* Footer */
        footer {
            background: var(--header-color) !important;
            position: relative;

            margin-top: auto;
        }

        /* Dropdown Enhancements */
        .dropdown-menu {
            background: var(--secondary-color) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
        }

        .dropdown-item {
            color: var(--text-color) !important;
            transition: all 0.3s ease;
        }

        .dropdown-item:hover {
                background: var(--hover-effect) !important;
                color: var(--accent-color) !important;
         }

        /* Responsive Adjustments */
        @@media (max-width: 768px) {
            .modern-item {
                padding: 12px;
            }

            .modern-icon {
                width: 40px;
                height: 40px;
                margin-right: 12px;
            }

            .ai-btn {
                bottom: 20px;
                right: 20px;
                width: 50px;
                height: 50px;
                font-size: 1.3rem;
            }

            .profile-image-container {
                width: 80px;
                height: 80px;
            }
        }

        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--secondary-color);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--accent-color);
            border-radius: 4px;
        }
       ::-webkit-scrollbar-thumb:hover {
            background: #0db354;
       }
    </style>
</head>
