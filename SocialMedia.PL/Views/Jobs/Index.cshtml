@model List<SocialMedia.BLL.ModelVM.job.Jobvm>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">?? All Jobs</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> @SharedLocalizer["Add New Job"]
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th> @SharedLocalizer["Title"]</th>
                        <th>@SharedLocalizer["Company"]</th>
                        <th>@SharedLocalizer["Description"]</th>
                        <th>@SharedLocalizer["Posted Date"]</th>
                        <th style="width: 220px;">@SharedLocalizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var job in Model)
                        {
                            <tr class="text-white">
                                <td>@job.Title</td>
                                <td>@job.Company</td>
                                <td class="text-truncate" style="max-width: 200px;">@job.Description</td>
                                <td>@job.PostedDate.ToShortDateString()</td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-info btn-sm me-1">
                                        <i class="fas fa-eye"></i> @SharedLocalizer["Details"]
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@job.Id" method="post" style="display:inline">
                                        <button type="submit" class="btn btn-danger btn-sm me-1">
                                            <i class="fas fa-trash"></i> @SharedLocalizer["Delete"]
                                        </button>
                                    </form>

                                    <form asp-action="ToggleSave" asp-route-id="@job.Id" method="post" style="display:inline">
                                        <button type="submit" class="btn btn-warning btn-sm">
                                            <i class="fas fa-bookmark"></i> @SharedLocalizer["Save"]
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fas fa-briefcase fa-2x mb-2"></i>
                                <div>@SharedLocalizer["No jobs available yet."]</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
