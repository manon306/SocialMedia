@model List<SocialMedia.BLL.ModelVM.job.Jobvm>

<h2>Saved Jobs</h2>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3">
        No saved jobs yet.
    </div>
}
else
{
    <table class="table table-striped mt-3">
        <thead>
            <tr class="text-white">
                <th> @SharedLocalizer["Title"]</th>
                <th>@SharedLocalizer["Company"]</th>
                <th>@SharedLocalizer["Location"]</th>
                <th>@SharedLocalizer["Posted Date"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model)
            {
                <tr class="text-white">
                    <td>@job.Title</td>
                    <td>@job.Company</td>
                    <td>@job.PostedDate.ToShortDateString()</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-info btn-sm">Details</a>
                        <form asp-action="ToggleSave" asp-route-id="@job.Id" method="post" style="display:inline">
                            <button type="submit" class="btn btn-warning btn-sm">
                                @SharedLocalizer["Unsave"]
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
<a asp-action="Index" class="btn btn-secondary mt-3">@SharedLocalizer["Back to All Jobs"]</a>
