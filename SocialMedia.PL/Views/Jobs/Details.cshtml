@model SocialMedia.BLL.ModelVM.job.Jobvm

@{
    ViewData["Title"] = "Job Details";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4 job-details-card">
        <div class="card-body">
            <h2 class="fw-bold text-accent mb-3">
                <i class="fa-solid fa-briefcase"></i> @Model.Title
            </h2>
            <h5 class="text-muted mb-3">
                <i class="fa-solid fa-building"></i> @Model.Company
            </h5>

            <p class="card-text">
                <strong class="text-accent">@SharedLocalizer["Description"]:</strong><br />
                <span class="text-light">@Model.Description</span>
            </p>

            <p class="card-text mt-3">
                <strong class="text-accent">@SharedLocalizer["Posted Date"]:</strong>
                <span class="text-light">@Model.PostedDate.ToShortDateString()</span>
            </p>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-accent">
            <i class="fa-solid fa-arrow-left"></i> @SharedLocalizer["Back to List"]
        </a>
    </div>
</div>

<style>
    :root {
        --primary-color: #1a1a2e;
        --secondary-color: #16213e;
        --accent-color: #0fce5b;
        --header-color: #0d1930;
        --text-color: #ffffff;
        --muted-text: #b0b0b0;
        --shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    body {
        background: linear-gradient(135deg, var(--primary-color) 0%, #0f3460 100%);
        color: var(--text-color);
    }

    .job-details-card {
        background: linear-gradient(180deg, var(--secondary-color) 0%, var(--header-color) 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 20px;
    }

    .text-accent {
        color: var(--accent-color);
    }

    .btn-accent {
        background: var(--accent-color);
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 10px 20px;
        transition: all 0.3s ease;
    }

        .btn-accent:hover {
            background: #12e065;
            transform: translateY(-2px);
        }
</style>
