@model SocialMedia.BLL.ModelVM.job.Jobvm

<h2>Job Details</h2>

<div class="card mt-3">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <h6 class="card-subtitle mb-2 text-muted">@Model.Company</h6>
        <p class="card-text">
            <strong>Description:</strong> @Model.Description
        </p>
        <p class="card-text">
            <strong>Posted Date:</strong> @Model.PostedDate.ToShortDateString()
        </p>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Back to List</a>
