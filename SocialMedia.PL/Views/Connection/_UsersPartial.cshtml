@using SocialMedia.BLL.ModelVM.Connect
@model IEnumerable<SocialMedia.BLL.ModelVM.Connect.FriendVM>

@foreach (var user in Model)
{
    <div class="col-md-6 col-lg-4">
        <div class="card bg-dark text-light shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <img src="~/Images/04250c9f-dc68-4b11-b80a-3939a7a50431ChatGPT Image 12 أغسطس 2025، 03_58_48 م.png"
                     class="rounded-circle me-3 border border-secondary"
                     width="60" height="60"
                     alt="Profile Image" />

                <div class="flex-grow-1">
                    <h6 class="mb-0">@(!string.IsNullOrEmpty(user.Name) ? user.Name : user.Email)</h6>
                    <small class="text-muted">@user.Headline</small>
                </div>
            </div>
            <div class="card-footer bg-transparent d-flex justify-content-between">
                <!-- Connect -->
                <form asp-controller="Connection" asp-action="SendRequest" method="post" class="d-inline">
                    <input type="hidden" name="receiverId" value="@user.Id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fa fa-user-plus me-1"></i>  @SharedLocalizer["Connect"]
                    </button>
                </form>
            </div>
        </div>
    </div>
}
